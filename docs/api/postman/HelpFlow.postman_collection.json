{
  "info": {
    "name": "HelpFlow API",
    "description": "Flujo básico de registro, autenticación y gestión de tickets.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key":"baseUrl","value":"http://localhost:8080"},
    {"key":"token","value":""},
    {"key":"techToken","value":""},
    {"key":"ticketId","value":""}
  ],
  "item": [
    {"name":"Auth", "item":[
      {"name":"Register", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/auth/register","body":{"mode":"raw","raw":"{\n  \"name\": \"Isaac\",\n  \"email\": \"isaac@example.com\",\n  \"password\": \"ChangeMe123!\"\n}","options":{"raw":{"language":"json"}}}}},
      {"name":"Login", "event":[{"listen":"test","script":{"exec":["const data = pm.response.json();","if (data.token) pm.collectionVariables.set('token', data.token);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/auth/login","body":{"mode":"raw","raw":"{\n  \"email\": \"isaac@example.com\",\n  \"password\": \"ChangeMe123!\"\n}","options":{"raw":{"language":"json"}}}}}
    ]},
    {"name":"Tickets", "item":[
      {"name":"Create Ticket", "event":[{"listen":"test","script":{"exec":["const data = pm.response.json();","if (data.id) pm.collectionVariables.set('ticketId', data.id);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/tickets","body":{"mode":"raw","raw":"{\n  \"title\": \"El equipo no enciende\",\n  \"description\": \"El portátil no enciende al presionar el botón.\",\n  \"category\": \"HARDWARE\",\n  \"priority\": \"ALTA\"\n}","options":{"raw":{"language":"json"}}}}},
      {"name":"My Tickets", "request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/tickets/me"}},
      {"name":"Get Ticket", "request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/tickets/{{ticketId}}"}},
      {"name":"Change Ticket Status", "request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{techToken}}"}],"url":"{{baseUrl}}/api/tickets/{{ticketId}}/status","body":{"mode":"raw","raw":"{\n  \"status\": \"EN_PROGRESO\",\n  \"observation\": \"Se inicia el diagnóstico.\"\n}","options":{"raw":{"language":"json"}}}}}
    ]},
    {"name":"Dispatch Simulator", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"http://localhost:8081/technician-dispatch","body":{"mode":"raw","raw":"{\n  \"ticketId\": \"10000000-0000-0000-0000-000000000001\",\n  \"category\": \"HARDWARE\",\n  \"priority\": \"ALTA\"\n}","options":{"raw":{"language":"json"}}}}}
  ]
}
